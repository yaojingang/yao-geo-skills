{
  "optimizer_hints": {
    "capability": "Discover, preview, clone, compare, and plan current GEOFlow frontend experiences safely",
    "inputs": [
      "GEOFlow workspace",
      "reference URL",
      "theme id",
      "homepage-design.json",
      "channel frontend capabilities",
      "target package report"
    ],
    "trigger_actions": [
      "discover themes",
      "create preview-first design plans",
      "map references to GEOFlow frontend modules",
      "generate homepage module/style JSON",
      "compare default-site and channel capabilities",
      "plan sync preview"
    ],
    "exclusions": [
      "CLI operations",
      "backend implementation",
      "database changes",
      "direct live activation",
      "raw HTML copy"
    ],
    "artifacts": [
      "theme-discovery",
      "homepage-design.json",
      "capability gap report",
      "sync preview report",
      "preview/finalize plan"
    ]
  },
  "fallback_positive_concepts": [
    "geoflow_frontend_design"
  ],
