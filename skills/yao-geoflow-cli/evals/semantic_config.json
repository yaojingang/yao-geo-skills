{
  "optimizer_hints": {
    "capability": "Operate an existing GEOFlow system through supported CLI, API v1, or admin web surfaces",
    "inputs": [
      "GEOFlow workspace",
      "CLI config",
      "API token",
      "admin session",
      "resource IDs"
    ],
    "trigger_actions": [
      "operate GEOFlow",
      "create or inspect tasks",
      "manage articles or materials",
      "use admin web for management workflows",
      "run preflight and verify readback"
    ],
    "exclusions": [
      "backend implementation",
      "schema changes",
      "direct database edits",
      "frontend design",
      "auth or CSRF bypass"
    ],
    "artifacts": [
      "operation result",
      "route or command report",
      "verification readback"
    ]
